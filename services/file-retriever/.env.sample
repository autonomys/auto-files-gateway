SUBSPACE_GATEWAY_URL=
API_SECRET=random-secret
CORS_ORIGIN=*
NETWORK_ID=taurus
NODE_DOCKER_TAG=latest
MAX_SIMULTANEOUS_FETCHES=10 # optional
CACHE_DIR=./.cache # optional
CACHE_MAX_SIZE=1024000000 # optional
CACHE_TTL=86400000 # optional
DAG_INDEXER_FALLBACK_ENABLED=true # optional, reconstruct metadata/chunks from the DSN when the DAG indexer has no row
DAG_INDEXER_FALLBACK_MAX_NODES=5000 # optional
DAG_INDEXER_FALLBACK_CHUNK_LIST_CACHE_MAX_CHUNKS=100000 # optional, total chunk records cached across all rebuilt lists
DAG_INDEXER_FALLBACK_DEADLINE_MS=45000 # optional, wall-clock budget for one reconstruction (0 disables)
DAG_INDEXER_LAG_ALERT_BLOCKS=1000 # optional, lag at which /health/dag-indexer reports degraded
UNAVAILABLE_RETRY_AFTER_SECONDS=60 # optional
